# Local development environment template. Do not place secrets in this file.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Render: set this to the generated HTTPS address, e.g.
# https://osobny-financny-asistent-api.onrender.com
BASE_URL=http://localhost:3000
# Set true on Render to register ${BASE_URL}/api/telegram/webhook after startup.
REGISTER_TELEGRAM_WEBHOOK=false

# Supabase: use only the service-role key on the backend, never in a web/mobile client.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Telegram. The secret is optional and is sent to Telegram when a webhook is
# registered; it is not required by the current webhook handler.
TELEGRAM_BOT_TOKEN=VLOZ_SEM_TVOJ_TOKEN
TELEGRAM_WEBHOOK_SECRET=

# Required for voice transcription, receipt OCR, and monthly AI commentary.
OPENAI_API_KEY=replace_me
INTERNAL_CRON_SECRET=replace_me_with_a_different_long_random_secret

# Optional monthly-report e-mail delivery via Resend. Leave all three empty to
# send reports only in Telegram. EMAIL_TO may contain comma-separated addresses.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=reports@example.com
EMAIL_TO=you@example.com
