{
  "name": "osobny-financny-asistent",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-channel AI SaaS platform for personal finance management.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @ofa/api dev",
    "dev:web": "pnpm --filter @ofa/web dev",
    "build": "pnpm --filter @ofa/api build",
    "build:web": "pnpm --filter @ofa/web build",
    "start:api": "pnpm --filter @ofa/api start",
    "verify:telegram-env": "pnpm --filter @ofa/api verify:telegram-env",
    "typecheck": "pnpm --filter @ofa/api typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ]
}
